{
  "name": "cct-group-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/index.mjs",
    "build": "vite build",
    "build:pages": "vite build --base=/cct-compute-chain/",
    "start": "node server/index.mjs",
    "test": "node --test tests/backend.test.mjs",
    "test:browser": "node qa/smoke.mjs",
    "verify": "pnpm build && pnpm test && pnpm test:browser && pnpm audit --prod",
    "setup": "node scripts/setup.mjs",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0"
  }
}
